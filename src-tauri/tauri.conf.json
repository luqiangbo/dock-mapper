{
  "productName": "DockMapper",
  "identifier": "com.luqiangbo.dockmapper",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:13301",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "beforeBundleCommand": "pnpm runtime:prepare"
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis"
    ],
    "resources": [
      "resources/ocr/*",
      "resources/runtime/*"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/installer-hooks.nsh",
        "languages": [
          "SimpChinese"
        ]
      }
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DockMapper - 配置中心",
        "width": 920,
        "height": 680,
        "minWidth": 640,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "backgroundColor": "#00000000",
        "windowEffects": {
          "effects": [
            "mica"
          ],
          "state": "active"
        }
      },
      {
        "label": "taskbar_widget",
        "url": "/widget.html",
        "width": 220,
        "height": 40,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost http://dockmapper-shot.localhost; img-src 'self' asset: http://asset.localhost data: blob: http://dockmapper-shot.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; object-src 'none'; base-uri 'none'; frame-src 'none'"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/luqiangbo/dock-mapper/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkxREE1RUJDNEY2MDM0NjkKUldScE5HQlB2Rjdha1dyUHczeTdDbTQzUEJ3MnVnZ25NSmhFU0RtRU9YL0Zla1ZjeUNGSHNXMmQK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
