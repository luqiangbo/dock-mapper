{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "DockMapper 主配置窗口的最小权限",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-initialize-defaults",
    "allow-application-ready",
    "allow-get-runtime-logs",
    "allow-get-runtime-log-text",
    "allow-clear-runtime-logs",
    "allow-copy-text",
    "allow-append-runtime-log",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:event:allow-emit",
    "core:app:allow-version",
    "core:resources:allow-close",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-set-title",
    "core:window:allow-set-theme",
    "core:window:allow-toggle-maximize",
    "core:window:allow-start-dragging",
    "updater:allow-check",
    "updater:allow-download",
    "updater:allow-install",
    "process:allow-restart",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled",
    "allow-get-supported-keys",
    "allow-get-key-mappings",
    "allow-sync-key-mappings",
    "allow-get-key-mapping-status",
    "allow-set-key-mapping-enabled",
    "allow-get-legacy-key-mappings",
    "allow-clear-legacy-key-mappings",
    "allow-list-screenshot-history",
    "allow-get-screenshot-history-image",
    "allow-get-screenshot-history-thumbnail",
    "allow-set-screenshot-history-favorite",
    "allow-delete-screenshot-history",
    "allow-copy-screenshot-history",
    "allow-pin-screenshot-history",
    "allow-get-runtime-health",
    "allow-start-screenshot",
    "allow-start-quick-ocr",
    "allow-get-screenshot-config",
    "allow-update-screenshot-config",
    "allow-get-screenshot-shortcut-statuses",
    "allow-reset-screenshot-shortcuts",
    "allow-choose-screenshot-save-directory",
    "allow-export-diagnostics",
    "allow-get-widget-config",
    "allow-refresh-widget-position",
    "allow-update-widget-config",
    "allow-get-minimize-to-tray",
    "allow-set-minimize-to-tray",
    "allow-get-key-visualizer-config",
    "allow-update-key-visualizer-config",
    "allow-get-key-visualizer-status",
    "allow-retry-key-visualizer",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://github.com/luqiangbo/dock-mapper*"
        }
      ]
    },
    "allow-get-key-visualizer-session",
    "allow-get-key-visualizer-effects-status",
    "allow-locate-key-visualizer-mouse",
    "allow-open-screenshot-history-preview"
  ]
}
