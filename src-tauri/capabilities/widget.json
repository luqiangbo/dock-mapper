{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "taskbar-widget",
  "description": "任务栏挂件接收状态事件并上报布局状态",
  "windows": ["taskbar_widget"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:event:allow-emit",
    "allow-get-widget-config",
    "allow-sync-widget-dynamic-width",
    "allow-refresh-widget-position"
  ]
}
