{
  "name": "dock-mapper",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "rsbuild dev",
    "build": "rsbuild build",
    "preview": "rsbuild preview",
    "tauri": "pnpm exec tauri",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src",
    "format": "oxfmt src index.html screenshot.html widget.html key-visualizer-effects.html rsbuild.config.ts tsconfig.json package.json .oxfmtrc.json .oxlintrc.json",
    "format:check": "oxfmt --check src index.html screenshot.html widget.html key-visualizer-effects.html rsbuild.config.ts tsconfig.json package.json .oxfmtrc.json .oxlintrc.json",
    "test": "vitest run --passWithNoTests",
    "version:sync": "node .github/scripts/sync-version.mjs",
    "runtime:prepare": "node .github/scripts/prepare-vcredist.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "6.3.4",
    "@excalidraw/excalidraw": "0.18.1",
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-autostart": "^2.7.0",
    "@tauri-apps/plugin-opener": "^2.7.0",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "2.13.1",
    "antd": "6.6.5",
    "echarts": "6.1.0",
    "lucide-react": "1.49.0",
    "perfect-freehand": "1.2.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "roughjs": "4.6.6"
  },
  "devDependencies": {
    "@rsbuild/core": "^2.2.11",
    "@rsbuild/plugin-react": "^2.1.1",
    "@rsbuild/plugin-sass": "2.0.1",
    "@tauri-apps/cli": "^2.12.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "sass": "1.105.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@12.4.1"
}
